# Resmi OpenAI - AI cevaplari, okunus ve resmi OpenAI cevirisi
OPENAI_API_KEY=your-openai-api-key-here
# Yalniz UI'da "OpenAI (Reseller)" cevirisi secilirse kullanilir.
# Reseller anahtari UI'daki ayri ceviri alanina girilir; OPENAI_API_KEY aktarilmaz.
OPENAI_BASE_URL=https://reseller.example.com/
OPENAI_MODEL=gpt-4.1-mini
OPENAI_RESPONSE_MODEL=gpt-4.1-mini

# DeepL - istege bagli alternatif ceviri saglayicisi
DEEPL_API_KEY=your-deepl-api-key-here

# Hugging Face - istege bagli konusmaci diarizasyonu
HF_TOKEN=your-huggingface-token-here

# Yerel sunucu (istege bagli; varsayilanlar asagidadir)
HOST=127.0.0.1
# 0.0.0.0/LAN adresi kullanmayin: gecmis GET ve soket akisi kullanici girisiyle
# korunmaz. App-token uzak erisim kimlik dogrulamasi degildir; yerel kullanim icindir.
PORT=5000

# Yalniz farkli bir origin'den baglanmak gerekiyorsa virgulle ayirarak ayarla.
# ALLOWED_ORIGINS=http://127.0.0.1:5000,http://localhost:5000
