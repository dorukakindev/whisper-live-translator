# Official Anthropic - Claude replies, pronunciation, and translation
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_RESPONSE_MODEL=claude-haiku-4-5-20251001

# Official OpenAI - AI replies, pronunciation output, and translation
OPENAI_API_KEY=your-openai-api-key-here
# Used only when "OpenAI (Reseller)" is selected in the UI.
# Enter its credential in the separate UI field; OPENAI_API_KEY is not forwarded.
OPENAI_BASE_URL=https://reseller.example.com/
OPENAI_MODEL=gpt-4.1-mini
OPENAI_RESPONSE_MODEL=gpt-4.1-mini

# DeepL - optional alternative translation provider
DEEPL_API_KEY=your-deepl-api-key-here

# Hugging Face - optional speaker diarization
HF_TOKEN=your-huggingface-token-here

# Local backend (optional; defaults shown below)
HOST=127.0.0.1
# Do not bind to 0.0.0.0 or a LAN address. The app token is not a remote-access
# authentication system; the application is designed for localhost use.
PORT=5000

# Set only when a different trusted local origin is required (comma-separated).
# ALLOWED_ORIGINS=http://127.0.0.1:5000,http://localhost:5000
