{
    "name": "whisper-pro",
    "version": "1.0.0",
    "description": "Windows desktop assistant for live multilingual transcription, translation, and spoken replies",
    "type": "commonjs",
    "main": "main.js",
    "author": "dorukakindev",
    "license": "MIT",
    "scripts": {
        "start": "electron .",
        "dev": "set \"DEBUG=*\" && electron .",
        "build": "node build.js",
        "scan": "node build.js --scan-source",
        "audit:history": "node scripts/audit-git-history.js",
        "demo:media": "electron scripts/generate-public-demo.js",
        "demo:game-media": "electron scripts/generate-public-game-demo.js",
        "test:ui-language": "electron test_ui_language.js"
    },
    "dependencies": {
        "electron-store": "^8.2.0"
    },
    "devDependencies": {
        "electron": "^34.0.0",
        "electron-builder": "^24.6.4",
        "electron-packager": "^17.1.2"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/dorukakindev/whisper-live-translator.git"
    },
    "bugs": {
        "url": "https://github.com/dorukakindev/whisper-live-translator/issues"
    },
    "homepage": "https://github.com/dorukakindev/whisper-live-translator#readme",
    "keywords": [
        "faster-whisper",
        "live-transcription",
        "speech-to-text",
        "live-translation",
        "electron",
        "windows",
        "multilingual"
    ]
}
